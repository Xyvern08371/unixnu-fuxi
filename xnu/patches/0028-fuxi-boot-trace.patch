diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -653,6 +653,7 @@ kernel_bootstrap_thread(void)
 #if MACH_KDP
 	kernel_bootstrap_log("kdp_init");
 	kdp_init();
+	kprintf("FUXI BOOT: kdp_init done\n");
 #endif
 
 #if ALTERNATE_DEBUGGER
@@ -670,6 +671,7 @@ kernel_bootstrap_thread(void)
 #endif
 
 	kernel_startup_initialize_upto(STARTUP_SUB_SYSCTL);
+	kprintf("FUXI BOOT: SYSCTL phase done\n");
 
 	/*
 	 * Initialize the globals used for permuting kernel
@@ -687,6 +689,7 @@ kernel_bootstrap_thread(void)
 #ifdef  IOKIT
 	kernel_bootstrap_log("PE_init_iokit");
 	PE_init_iokit();
+	kprintf("FUXI BOOT: PE_init_iokit done\n");
 #endif
 
 	assert(ml_get_interrupts_enabled() == FALSE);
@@ -696,6 +699,7 @@ kernel_bootstrap_thread(void)
 	 * interrupts or preemption enabled may begin enforcement.
 	 */
 	kernel_startup_initialize_upto(STARTUP_SUB_EARLY_BOOT);
+	kprintf("FUXI BOOT: EARLY_BOOT phase done\n");
 
 #if SCHED_HYGIENE_DEBUG
 	// Reset interrupts masked timeout before we enable interrupts
@@ -707,10 +711,12 @@ kernel_bootstrap_thread(void)
 	 * This will start displaying progress to the user, start as early as possible
 	 */
 	initialize_screen(NULL, kPEAcquireScreen);
+	kprintf("FUXI BOOT: initialize_screen done\n");
 
 	/*
 	 *	Initialize the shared region module.
 	 */
+	kprintf("FUXI BOOT: before commpage_init\n");
 	vm_commpage_init();
 	vm_commpage_text_init();
 
@@ -745,6 +751,7 @@ kernel_bootstrap_thread(void)
 #endif
 
 	kernel_startup_initialize_upto(STARTUP_SUB_LOCKDOWN);
+	kprintf("FUXI BOOT: LOCKDOWN phase done\n");
 
 	/*
 	 * Get rid of segments used to bootstrap kext loading. This removes
@@ -754,10 +761,12 @@ kernel_bootstrap_thread(void)
 	 */
 	kernel_bootstrap_log("OSKextRemoveKextBootstrap");
 	OSKextRemoveKextBootstrap();
+	kprintf("FUXI BOOT: kext bootstrap removed\n");
 
 	/* No changes to kernel text and rodata beyond this point. */
 	kernel_bootstrap_log("machine_lockdown");
 	machine_lockdown();
+	kprintf("FUXI BOOT: machine_lockdown done\n");
 
 #ifdef CONFIG_XNUPOST
 	kern_return_t result = kernel_list_tests();
@@ -771,6 +780,7 @@ kernel_bootstrap_thread(void)
 #ifdef  IOKIT
 	kernel_bootstrap_log("PE_lockdown_iokit");
 	PE_lockdown_iokit();
+	kprintf("FUXI BOOT: PE_lockdown_iokit done\n");
 #endif
 	/*
 	 * max_cpus must be nailed down by the time PE_lockdown_iokit() finishes,
@@ -787,6 +797,7 @@ kernel_bootstrap_thread(void)
 	 *	Start the user bootstrap.
 	 */
 #ifdef  MACH_BSD
+	kprintf("FUXI BOOT: entering bsd_init\n");
 	bsd_init();
 #endif
 
